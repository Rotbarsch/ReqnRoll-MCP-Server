<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!---DNX support-->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>Rotbarsch-ReqnrollMcpServer</ToolCommandName>

    <!--NuGet Metadata-->
    <PackageId>Rotbarsch.ReqnrollMcpServer</PackageId>
    <Authors>Rotbarsch</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--Fast startup-->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include third-party notices inside the NuGet package -->
    <None Include="../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReqnRollBindingMetadataExtractorService\ReqnRollBindingMetadataExtractorService.csproj" />
  </ItemGroup>

</Project>

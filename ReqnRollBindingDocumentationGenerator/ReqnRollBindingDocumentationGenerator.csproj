<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!---DNX support-->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>Rotbarsch-ReqnrollDocumentationGenerator</ToolCommandName>

    <!--NuGet Metadata-->
    <PackageId>Rotbarsch.ReqnrollDocumentationGenerator</PackageId>
    <Authors>Rotbarsch</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>../README.md</PackageReadmeFile>

    <!--Fast startup-->
    <PublishReadyToRun>true</PublishReadyToRun>

  </PropertyGroup>

  <ItemGroup>
    <!-- Include third-party notices inside the NuGet package -->
    <None Include="../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReqnRollBindingMetadataExtractorService\ReqnRollBindingMetadataExtractorService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="inputs.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
